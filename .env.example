# E-com.casa — environment template
# Never commit real secrets. Configure Production values in Vercel.

# --- Database ---
DATABASE_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://e-com.casa

# --- Payments: XPayments Stripe-compatible LIVE Store ---
# The E-com.casa backend uses XPayments, not a direct Stripe secret key.
PAYMENT_ENVIRONMENT=live
XPAYMENTS_STRIPE_BASE_URL=https://api.xpayments.digital/api/stripe/v1
XPAYMENTS_API_KEY=xp_live_
XPAYMENTS_STORE_ID=ECOM-CASA
NEXT_PUBLIC_XPAYMENTS_STRIPE_PUBLISHABLE_KEY=pk_live_
# Optional merchant callback. Leave empty when XPayments/Stripe own the
# provider webhook lifecycle; checkout reconciles PaymentIntents server-side.
XPAYMENTS_WEBHOOK_SECRET=
# Optional Stripe-compatible version required by the XPayments contract.
STRIPE_API_VERSION=
# Random server-only secret used by Vercel Cron for delayed payment reconciliation.
# Generate a long random value; Vercel sends it as Authorization: Bearer <secret>.
CRON_SECRET=

# --- Transactional email: Resend ---
# Server-only. Never expose this value with NEXT_PUBLIC_.
RESEND_API_KEY=

# --- Production supplier catalogue: BigBuy ---
# Requires an active BigBuy Ecommerce/Marketplace relationship and API key.
BIGBUY_API_BASE_URL=https://api.bigbuy.eu
BIGBUY_API_KEY=
BIGBUY_ISO_CODE=en
BIGBUY_TARGET_PRODUCTS=220
BIGBUY_MIN_STOCK=3
BIGBUY_MAX_HANDLING_DAYS=4
BIGBUY_PRICE_MARKUP=1.28
# Initial VAT-inclusive price calibration only; fiscal engine remains separate.
BIGBUY_PRICE_VAT_RATE=0.23
# Set to 1 ONLY while your active BigBuy agreement grants commercial media use.
BIGBUY_ASSET_RIGHTS_CONFIRMED=0
BIGBUY_RETIRE_DEMO=1
# Optional: comma-separated first-level taxonomy IDs; auto-detected if empty.
BIGBUY_TAXONOMY_IDS=

# --- Storefront ---
# Payment methods are discovered dynamically by the Stripe-compatible Payment Element.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_CHAT_ENABLED=true

# --- Optional analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- One-shot catalog research (development only) ---
REQUEST_DELAY_MS=1500
MAX_PAGES_PER_SOURCE=8
MAX_PRODUCT_PAGES=48
# RESEARCH_DISABLE_WEBSEARCH=1
# RESEARCH_DISABLE_HTTP=1
# RESEARCH_DISABLE_LLM=1
# IMAGE_DELAY_MS=300
