# Database
# Use the Supabase pooled PostgreSQL URL for Vercel runtime traffic.
DATABASE_URL=
# Use the direct/session connection only for migrations or maintenance tooling.
DIRECT_URL=

# Admin
# Fixed team password. Store only in the deployment environment, never in Git.
ADMIN_PASSWORD=
# Independent random secret used to sign admin sessions.
ADMIN_SESSION_SECRET=
# Name recorded in offer audit entries.
ADMIN_OPERATOR=commerce-team

# Site
NEXT_PUBLIC_SITE_URL=https://e-com.casa
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CHAT_ENABLED=true

# Payments: XPayments Stripe-compatible API
PAYMENT_ENVIRONMENT=live
XPAYMENTS_STRIPE_BASE_URL=https://api.xpayments.digital/api/stripe/v1
XPAYMENTS_API_KEY=
XPAYMENTS_STORE_ID=ECOM-CASA
NEXT_PUBLIC_XPAYMENTS_STRIPE_PUBLISHABLE_KEY=
XPAYMENTS_WEBHOOK_SECRET=
STRIPE_API_VERSION=
CRON_SECRET=

# Transactional email
RESEND_API_KEY=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
