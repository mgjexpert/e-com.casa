# ============================================================
# E-com.casa — environment template
# Copy to .env (never commit .env) and fill with real values.
# In Vercel, configure these in Project → Settings → Environment Variables.
# ============================================================

# --- Database (Neon PostgreSQL) ---
# Neon connection string from Vercel integration or Neon console.
# Use the POOLED endpoint for the app runtime (-pooler in the host).
# Example: postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Site ---
# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://e-com.casa

# --- Payments (XPayments — Stripe-compatible Direct API) ---
# test | live. Never mix test and live credentials.
PAYMENT_ENVIRONMENT=test

# XPayments Stripe-compatible base URL (preserve exactly)
XPAYMENTS_API_BASE_URL=https://api.xpayments.digital/api/stripe/v1
# SERVER-ONLY secret — xp_test_* / xp_live_*. NEVER expose to the browser.
XPAYMENTS_SECRET_KEY=
# Merchant webhook signing secret — used for fail-closed verification.
XPAYMENTS_WEBHOOK_SECRET=
# Optional store/mid identifier included as intent metadata.
XPAYMENTS_STORE_ID=

# PUBLIC publishable key (pk_test_* / pk_live_*) — safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe-Version header preserved on every XPayments request.
# Validate the value against the XPayments compatibility layer.
STRIPE_API_VERSION=

# --- Payment methods (storefront activation) ---
# Comma-separated active methods. PIX is always opt-in and country-gated
# (BR/BRL only) — it is never shown in European checkout.
# Default: card,mb_way,multibanco,bizum,blik,bancontact
# PAYMENT_METHODS=card,mb_way,multibanco,bizum,blik,bancontact

# --- Feature switches ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Keep indexing OFF until the real catalogue and checkout are live
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_CHAT_ENABLED=true

# --- Optional: analytics (load ONLY after cookie consent) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- One-shot catalog research pipelines (dev-only, optional) ---
# The research utilities are NOT part of the storefront runtime
# and must never be exposed as public routes or cron jobs.
REQUEST_DELAY_MS=1500
MAX_PAGES_PER_SOURCE=8
MAX_PRODUCT_PAGES=48
# RESEARCH_DISABLE_WEBSEARCH=1
# RESEARCH_DISABLE_HTTP=1
# RESEARCH_DISABLE_LLM=1     # fall back to template copy in catalog:scrape-v2
# IMAGE_DELAY_MS=300
