# E-com.casa — environment template
# Never commit real secrets. Configure Production values in Vercel.

# --- Database ---
# Runtime PostgreSQL connection. Neon today; Supabase pooled connection after cutover.
DATABASE_URL=
# Reserved for direct/admin migration access to the future Supabase database.
# The application does not depend on DIRECT_URL at runtime yet.
DIRECT_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://e-com.casa

# --- Payments: XPayments Stripe-compatible LIVE Store ---
PAYMENT_ENVIRONMENT=live
XPAYMENTS_STRIPE_BASE_URL=https://api.xpayments.digital/api/stripe/v1
XPAYMENTS_API_KEY=xp_live_
XPAYMENTS_STORE_ID=ECOM-CASA
NEXT_PUBLIC_XPAYMENTS_STRIPE_PUBLISHABLE_KEY=pk_live_
XPAYMENTS_WEBHOOK_SECRET=
STRIPE_API_VERSION=
CRON_SECRET=

# --- Transactional email: Resend ---
RESEND_API_KEY=

# --- Storefront ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_CHAT_ENABLED=true

# --- Optional analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Supplier scrapers, BigBuy, Shopify scanning and scheduled catalogue research
# were intentionally retired. Catalogue/product mutations belong in PostgreSQL
# (Supabase after cutover), not in Git-generated snapshots or deploy jobs.
