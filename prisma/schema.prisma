// ============================================================
// E-com.casa — Prisma schema (PostgreSQL / Neon)
// ------------------------------------------------------------
// Datasource is PostgreSQL (Neon in production via DATABASE_URL).
// All demo catalogue data is seeded idempotently from
// /data/catalog/generated-*.json artifacts produced by the
// one-shot research pipeline (npm run catalog:research).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// E-com.casa — Catalogue
// ============================================================

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  sku         String  @unique // stable identity used by seed/import upserts
  name        String
  subtitle    String? // short variant line e.g. "Natural Oak · 240cm"
  shortDescription String @default("") // 1–2 sentence merchandising summary
  description String

  // Pricing (VAT-inclusive display; price stays the human string, priceCents drives sorting/filtering)
  price        String // "49.90"
  priceCents   Int // 4990 — numeric twin of price for correct numeric ordering/filtering
  comparePrice String? // previous price if valid (never fabricated by UI)
  currency     String  @default("EUR")

  // Classification
  categorySlug String // e.g. "wall-panels", "lighting", "garden"
  subcategorySlugs String @default("") // comma separated: "wood-slat-panels,mirrors"
  spaceSlugs   String @default("") // comma separated: "living-room,garden"
  styleSlugs   String @default("") // comma separated: "warm-minimal,natural"
  collectionSlugs String @default("") // e.g. "wall-makeover,mood-lighting"

  // Media — only own/demo imagery is ever served (never hotlinked source photography)
  image      String
  hoverImage String?
  gallery    String @default("") // comma separated additional image paths
  imageStatus String @default("PLACEHOLDER") // PLACEHOLDER | GENERATED | LICENSED | ORIGINAL

  // Merchandising
  badge       String? // "New" | "Featured" | "Popular" | "Editor's Pick" | "Best Seller" (demo merchandising label)
  rating      Float   @default(4.5) // demo presentation value — reviews are demo-mode
  reviewCount Int     @default(0)
  stock       Int     @default(50) // demo stock
  availability String @default("inStock") // inStock | lowStock | outOfStock (demo — no false scarcity)
  isBestSeller Boolean @default(false)
  isNew       Boolean @default(false)
  featured    Boolean @default(false)

  // Details
  materials  String? // comma separated normalized materials
  dimensions String?
  weight     String? // e.g. "2.4 kg"
  care       String?
  color      String? // normalized colour for filters

  // Logistics (demo classification — not final carrier data)
  shippingClass String @default("STANDARD") // SMALL | STANDARD | FRAGILE | OVERSIZED | HEAVY | SPECIAL

  // Variants (JSON array: [{ type: "colour"|"size"|"pack", name, value, priceDeltaCents?, image? }])
  variantsJson String @default("[]")

  // GPSR / compliance scaffold (never fabricate: demo products stay DEMO)
  electrical        Boolean @default(false)
  battery           Boolean @default(false)
  complianceStatus  String  @default("DEMO") // DEMO | PENDING_REVIEW | APPROVED | BLOCKED
  reviewMode        String  @default("demo") // demo | live
  documentationStatus String @default("DEMO") // DEMO | PENDING | REVIEW | APPROVED | BLOCKED
  safetyJson        String? // JSON: manufacturer placeholder, warnings, euResponsiblePerson placeholders, etc.
  requiresComplianceReview Boolean @default(false)

  // Demo identity & research traceability (internal, not exposed in storefront UI)
  isDemo           Boolean @default(true)
  sourceResearchId String? // ResearchProduct/ResearchRun reference (internal)
  sourceDomain     String? // internal research metadata
  sourceUrl        String? // internal research metadata

  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorySlug])
  @@index([priceCents])
  @@index([isDemo])
}

model Review {
  id          String   @id @default(cuid())
  productSlug String
  author      String
  country     String   @default("")
  rating      Int // 1..5
  title       String   @default("")
  body        String
  email       String? // optional, never exposed via API — used only for verified-buyer matching
  verified    Boolean  @default(false) // true only when the submitted email matches an Order containing this product
  status      String   @default("APPROVED") // APPROVED | PENDING | REJECTED (demo store auto-approves, but keep the scaffold)
  createdAt   DateTime @default(now())

  @@index([productSlug, status])
}

model Category {
  id       String @id @default(cuid())
  slug     String
  name     String
  type     String // "space" | "style" | "collection" | "shop"
  image    String?
  subtitle String?
  sortOrder Int    @default(0)

  @@unique([type, slug])
  @@index([slug])
}

// ============================================================
// Orders (demo checkout — no real payment processing in V1)
// ============================================================

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique // EC-XXXXXX

  email     String
  firstName String
  lastName  String
  address   String
  address2  String?
  city      String
  postalCode String
  country   String
  phone     String?

  shippingMethod String @default("standard") // standard | express
  paymentMethod  String @default("card")     // card | paypal (mock)

  subtotal  String
  shipping  String
  tax       String
  discount  String @default("0.00")
  total     String
  promoCode String?

  itemsJson String // JSON array of line items snapshot
  giftWrap  Boolean @default(false) // gift wrap service (+ fixed fee)
  notes     String? // customer delivery notes / gift message (max 500 chars)
  status    String @default("CONFIRMED") // CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  paymentStatus String @default("PAID") // mock: PAID | PENDING | REFUNDED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Marketing / compliance records
// ============================================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  country   String   @default("")
  locale    String   @default("")
  marketingConsent Boolean @default(false) // explicit, never pre-checked
  consentAt DateTime @default(now())
  consentVersion String @default("1.0")
  privacyVersion  String @default("1.0")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  orderRef  String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ============================================================
// One-shot catalog research layer (internal ONLY).
// Never exposed via public routes, cron jobs or the storefront.
// research data ≠ production product.
// ============================================================

model ResearchSource {
  id        String   @id @default(cuid())
  key       String   @unique // stable key e.g. "kave-home"
  name      String
  domain    String
  homepage  String
  tier      Int      @default(2) // 1 | 2 | 3
  enabled   Boolean  @default(true)
  priority  Int      @default(50)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResearchRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  mode         String    @default("import") // import | dry-run
  sourceCount  Int       @default(0)
  pagesVisited Int       @default(0)
  productsDiscovered Int @default(0)
  productsNormalized Int @default(0)
  productsRejected   Int @default(0)
  productsImported   Int @default(0)
  errorsJson   String    @default("[]")
  notes        String?
}

model ResearchProduct {
  id             String   @id @default(cuid())
  researchRunId  String
  sourceId       String?

  sourceUrl      String
  sourceProductId String?
  sourceProductName String
  sourceBrand    String?

  sourceCategory   String?
  sourceSubcategory String?
  sourceCollection String?

  sourcePrice    String?
  sourceCurrency String?
  sourceSalePrice String?

  sourceAvailability String?

  sourceSku  String?
  sourceGtin String?

  sourceDescription String?

  sourceMaterials  String?
  sourceColours    String?
  sourceDimensions String?
  sourceWeight     String?

  sourceAttributes String? // JSON
  sourceImageUrls  String? // JSON array — internal research metadata only, never published

  sourceDataJson String? // limited structured extract (no personal data, no full HTML)

  productFingerprint String?
  researchScore      Int?    // 0..100
  scoreBreakdownJson String? // JSON per-criterion scores

  status String @default("DISCOVERED") // DISCOVERED | PARSED | NORMALIZED | DUPLICATE | REJECTED | SELECTED | IMPORTED | BLOCKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([researchRunId])
  @@index([status])
  @@index([productFingerprint])
}
