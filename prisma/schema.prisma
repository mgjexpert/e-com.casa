generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// E-com.casa — Catalogue
// ============================================================

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  subtitle    String? // short variant line e.g. "Natural Oak · 240cm"
  description String

  // Pricing (minor-safe: stored as decimal string, EUR, VAT incl.)
  price        String // "49.90"
  comparePrice String? // previous price if valid (never fabricated by UI)
  currency     String  @default("EUR")

  // Classification
  categorySlug String // e.g. "wall-panels", "lighting", "garden"
  spaceSlugs   String @default("") // comma separated: "living-room,garden"
  styleSlugs   String @default("") // comma separated: "warm-minimal,natural"
  collectionSlugs String @default("") // e.g. "wall-makeover,mood-lighting"

  // Media
  image      String
  hoverImage String?
  gallery    String @default("") // comma separated additional image paths

  // Merchandising
  badge       String? // "Bestseller", "New", "Set of 2"
  rating      Float   @default(4.5)
  reviewCount Int     @default(0)
  stock       Int     @default(50)
  isBestSeller Boolean @default(false)
  isNew       Boolean @default(false)
  featured    Boolean @default(false)

  // Details
  materials  String?
  dimensions String?
  care       String?
  color      String? // for filters

  // GPSR / compliance scaffold (never fabricate: store placeholders only)
  electrical        Boolean @default(false)
  complianceStatus  String  @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | BLOCKED
  safetyJson        String? // JSON: manufacturer, warnings, etc.

  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  productSlug String
  author      String
  country     String   @default("")
  rating      Int // 1..5
  title       String   @default("")
  body        String
  verified    Boolean  @default(false) // true only if an Order exists with this email — for now always false
  status      String   @default("APPROVED") // APPROVED | PENDING | REJECTED (demo store auto-approves, but keep the scaffold)
  createdAt   DateTime @default(now())

  @@index([productSlug, status])
}

model Category {
  id       String @id @default(cuid())
  slug     String
  name     String
  type     String // "space" | "style" | "collection" | "shop"
  image    String?
  subtitle String?
  sortOrder Int    @default(0)

  @@unique([type, slug])
  @@index([slug])
}

// ============================================================
// Orders
// ============================================================

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique // EC-XXXXXX

  email     String
  firstName String
  lastName  String
  address   String
  address2  String?
  city      String
  postalCode String
  country   String
  phone     String?

  shippingMethod String @default("standard") // standard | express
  paymentMethod  String @default("card")     // card | paypal (mock)

  subtotal  String
  shipping  String
  tax       String
  discount  String @default("0.00")
  total     String
  promoCode String?

  itemsJson String // JSON array of line items snapshot
  status    String @default("CONFIRMED") // CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  paymentStatus String @default("PAID") // mock: PAID | PENDING | REFUNDED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Marketing / compliance records
// ============================================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  orderRef  String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}
